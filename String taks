//Convert string to lowercase without using toLowerCase().
	       public static String tolower(String str) {
				String result="";
				for(int i=0;i<str.length();i++) {
					char ch=str.charAt(i);
					if(ch>='A'&&ch<='Z') {
						ch=(char)(ch-32);
					}
					result +=ch;
				}
				return result;
			}
