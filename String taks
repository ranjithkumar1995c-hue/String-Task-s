//Remove spaces from a string.
public static String removespaces (String str) {
	String result=" ";
	for(int i=0;i<str.length();i++)
	{
		char ch=str.charAt(i);
		if(ch!=' ') {
			result +=ch;
		}
	}
	return result;
}
