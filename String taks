	public static int countvowels(String str) {
		if(str==null)
		return 0;
	  
	    int count=0;
		str=str.toLowerCase();
		for(int i=0;i<str.length();i++) {
			char ch=str.charAt(i);
			if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u');
			{
				count++;
			}
			}
		return count;
		}
